{% extends "simplified-account/settings/settings-layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set settingsPageTitle = 'What will your service be taking payments for?' %}

{% block settingsContent %}
  <form id="reason-for-taking-payments-form" autocomplete="off" method="post" class="govuk-!-margin-top-3">
    <input id="csrf" name="csrfToken" type="hidden" value="{{ csrf }}" />
    {{
      govukRadios({
        name: "governmentActivity",
        fieldset: {
          legend: {
            text: "What will your service be taking payments for?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        hint: {
          text: "This helps the payment provider to categorise the service correctly."
        },
        errorMessage: {
          text: errors.formErrors['governmentActivity']
          } if errors.formErrors['governmentActivity'],
        items: [
          {
            value: "general-local",
            text: "General local government activities",
            attributes: {
              "data-cy": "radio-general-local"
            }
          },
          {
            value: "police-safety",
            text: "Police and public safety",
            attributes: {
              "data-cy": "radio-police-safety"
            }
          },
          {
            value: "everything-else",
            text: "Armed forces, cadets, colleges and everything else",
            attributes: {
              "data-cy": "radio-everything-else"
            }
          }
        ]
      })
    }}

    {{
      govukButton({
        id: "reason-for-taking-payments-submit",
        text: "Continue",
        preventDoubleClick: true
      })
    }}
  </form>
{% endblock %}
